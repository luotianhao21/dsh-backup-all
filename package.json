{
  "name": "dsh-backup-all",
  "version": "1.3.0",
  "description": "Snapshot everything in your DSH environment: one-click full backup and rollback of plugins, Skills, MCP servers, Agent Presets, config, credentials and external data.",
  "type": "module",
  "license": "MIT",
  "author": "luotianhao21",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luotianhao21/dsh-backup-all.git"
  },
  "homepage": "https://github.com/luotianhao21/dsh-backup-all#readme",
  "bugs": {
    "url": "https://github.com/luotianhao21/dsh-backup-all/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "backup",
    "snapshot",
    "restore",
    "disaster-recovery"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "prompts",
    "locale",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/API-CONTRACT.md",
    "docs/PLATFORM-STRATEGIES.md",
    "docs/UI-SPEC.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ]
    }
  }
}
